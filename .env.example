# Public frontend build configuration (not secrets).
# Copy this file to .env locally and fill in the values for your own Supabase project.
# These VITE_* values are included in the browser build; never put private credentials here.
VITE_SUPABASE_URL=
VITE_SUPABASE_KEY=
VITE_VAPID_PUBLIC_KEY=
VITE_WIKI_URL=
# Optional. Analytics stays disabled when this is empty.
VITE_GA_MEASUREMENT_ID=
